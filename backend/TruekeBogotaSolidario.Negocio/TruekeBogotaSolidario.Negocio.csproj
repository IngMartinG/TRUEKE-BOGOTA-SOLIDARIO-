<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TruekeBogotaSolidario.Negocio</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Capa BLL: referencia SOLO a Datos. Sin dependencia de ASP.NET Core. -->
  <ItemGroup>
    <!-- PrivateAssets="compile": Presentacion NO ve los tipos de Datos (un Controller no puede tocar un Repository). -->
    <ProjectReference Include="..\TruekeBogotaSolidario.Datos\TruekeBogotaSolidario.Datos.csproj" PrivateAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.77.0" />
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <!-- Llega transitivo por MimeKit (10.0.0) con CVE-2026-70162 y CVE-2026-84008: se fija la versión corregida;
         quitar cuando MimeKit la traiga solo. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.14" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <!-- Binarios nativos de Skia para Linux (Docker / Render) sin depender de fontconfig ni otras librerías del sistema. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TruekeBogotaSolidario.Pruebas" />
  </ItemGroup>

</Project>
