<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TruekeBogotaSolidario.Presentacion</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- false: Microsoft.Data.SqlClient no funciona en modo de globalización invariante (falla al abrir la conexión).
         La imagen aspnet:8.0 (Debian) ya incluye ICU. ArquitecturaTests lo verifica. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <UserSecretsId>trueke-bogota-solidario-api</UserSecretsId>
  </PropertyGroup>

  <!-- Capa de presentación: referencia SOLO a Negocio. Un controller no puede tocar un repositorio. -->
  <ItemGroup>
    <ProjectReference Include="..\TruekeBogotaSolidario.Negocio\TruekeBogotaSolidario.Negocio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="MessagePack" Version="2.5.305" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.13" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TruekeBogotaSolidario.Pruebas" />
  </ItemGroup>

</Project>
