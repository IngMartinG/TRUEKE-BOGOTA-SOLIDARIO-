# Copia este archivo a .env (está en .gitignore) y completa los valores. NUNCA subas .env al repositorio.
# docker-compose.yml lee estas variables y las traduce a la configuración de la API
# (en Azure App Service se definen directamente con "__": Jwt__Key, ConnectionStrings__TruekeDb, ...).

# Staging = base y Redis reales con correo/pagos simulados permitidos. Production exige todo real.
ASPNETCORE_ENVIRONMENT=Staging

# SQL Server: mínimo 8 caracteres con mayúscula, minúscula, número y símbolo.
SQL_SA_PASSWORD=

# Redis (backplane de SignalR)
REDIS_PASSWORD=

# JWT: mínimo 32 caracteres aleatorios. Genera una con:  openssl rand -base64 48
JWT_KEY=

# Wompi (solo pagos y recargas HACIA la plataforma). "Simulado" está prohibido en Production.
PAGOS_PROVEEDOR=Simulado
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_LLAVE_PUBLICA=
WOMPI_LLAVE_PRIVADA=
WOMPI_SECRETO_INTEGRIDAD=
WOMPI_SECRETO_EVENTOS=

# Correo saliente (verificación de cuenta y recuperación de contraseña). "Simulado" escribe los correos en el log.
# Con Smtp: Azure Communication Services (smtp.azurecomm.net), SendGrid (smtp.sendgrid.net), etc. Siempre con TLS.
CORREO_PROVEEDOR=Simulado
CORREO_REMITENTE=no-responder@trueke.co
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=

# Inicio de sesión con Google: OAuth Client ID (tipo "Aplicación web") de Google Cloud. Vacío = deshabilitado.
GOOGLE_CLIENT_ID=

# Azure Blob Storage para imágenes. Usa UNA de las dos: URL de la cuenta (Managed Identity en Azure) o cadena de conexión.
ALMACENAMIENTO_URL=
ALMACENAMIENTO_CADENA=

# Front Angular: los enlaces de los correos apuntan aquí y es el único origen permitido por CORS.
URL_FRONTEND=http://localhost:4200
CORS_ORIGEN=http://localhost:4200
# Strict si front y API comparten dominio (app.trueke.co / api.trueke.co); None si están en sitios distintos.
COOKIE_SAMESITE=Strict

# Primer SuperUsuario (solo se crea si no existe). Quítalo del .env después del primer arranque.
SUPERUSUARIO_CORREO=
SUPERUSUARIO_CLAVE=
