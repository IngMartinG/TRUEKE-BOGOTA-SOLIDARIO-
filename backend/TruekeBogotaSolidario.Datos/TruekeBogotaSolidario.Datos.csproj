<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TruekeBogotaSolidario.Datos</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Capa DAL: SOLO aquí viven los paquetes de EF Core -->
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Npgsql 10.0.3 trae EF Core Relational 10.0.4: se alinea con el resto de EF Core (10.0.13). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Catálogo oficial de departamentos y municipios (DANE - DIVIPOLA): datos de referencia de solo lectura -->
  <ItemGroup>
    <EmbeddedResource Include="Recursos\divipola.json" LogicalName="TruekeBogotaSolidario.Datos.divipola.json" />
  </ItemGroup>

</Project>
