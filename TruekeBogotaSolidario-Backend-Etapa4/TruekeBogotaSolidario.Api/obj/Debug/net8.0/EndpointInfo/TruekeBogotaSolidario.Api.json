          "descripcion",
          "titulo",
          "usuarioId"
        ],
        "type": "object",
        "properties": {
          "titulo": {
            "maxLength": 120,
            "minLength": 3,
            "type": "string"
          },
          "descripcion": {
            "maxLength": 1000,
            "minLength": 10,
            "type": "string"
          },
          "categoriaId": {
            "type": "integer",
            "format": "int32"
          },
          "usuarioId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "CrearSolicitudDto": {
        "required": [
          "mensaje",
          "publicacionId",
          "usuarioId"
        ],
        "type": "object",
        "properties": {
          "usuarioId": {
            "type": "string",
            "format": "uuid"
          },
          "publicacionId": {
            "type": "string",
            "format": "uuid"
          },
          "mensaje": {
            "maxLength": 500,
            "minLength": 5,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CrearUsuarioDto": {
        "required": [
          "correo",
          "localidad",
          "nombreCompleto"
        ],
        "type": "object",
        "properties": {
          "nombreCompleto": {
            "maxLength": 150,
            "minLength": 3,
            "type": "string"
          },
          "localidad": {
            "minLength": 1,
            "type": "string"
          },
          "correo": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          }
        },
        "additionalProperties": false
      },
      "EstadoPublicacionEnum": {
        "enum": [
          0,
          1,
          2,
          3
        ],
        "type": "integer",
        "format": "int32"
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "PublicacionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "titulo": {
            "type": "string",
            "nullable": true
          },
          "descripcion": {
            "type": "string",
            "nullable": true
          },
          "estado": {
            "$ref": "#/components/schemas/EstadoPublicacionEnum"
          },
          "fechaPublicacion": {
            "type": "string",
            "format": "date-time"
          },
          "categoriaId": {
            "type": "integer",
            "format": "int32"
          },
          "nombreCategoria": {
            "type": "string",
            "nullable": true
          },
          "usuarioId": {
            "type": "string",
            "format": "uuid"
          },
          "nombreUsuario": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
