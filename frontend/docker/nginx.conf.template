# Plantilla procesada con envsubst al arrancar (variables ${...} del entorno del contenedor).
# Las variables propias de nginx ($uri, $host...) no se tocan porque no existen en el entorno.

# Resolución en tiempo de ejecución: nginx arranca aunque la API aún no exista.
resolver ${NGINX_RESOLVER} valid=30s ipv6=off;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;
  client_max_body_size 1m;

  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

  include /etc/nginx/conf.d/seguridad.inc;

  # ---------- API y SignalR en el mismo origen (proxy inverso) ----------
  # Así la cookie de refresco (SameSite=Strict) y el hub funcionan sin CORS.
  location /api/ {
    set $api ${API_UPSTREAM};
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }
  location /hubs/ {
    set $api ${API_UPSTREAM};
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 1h;
    # El token del hub viaja en ?access_token=: nunca se registra la query string.
    access_log off;
  }

  location = /salud {
    access_log off;
    default_type text/plain;
    return 200 "ok";
  }

  # Configuración e índice: siempre frescos (cambian con cada despliegue).
  location = /config.json {
    # Generado al arrancar en /tmp: compatible con un sistema de archivos de solo lectura.
    alias /tmp/trueke-config.json;
    default_type application/json;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
  }
  location = /index.html {
    add_header Cache-Control "no-cache" always;
    include /etc/nginx/conf.d/seguridad.inc;
  }

  # Recursos con hash en el nombre: caché de un año.
  location ~* \.(?:js|css|woff2?|svg|png|ico|webp)$ {
    expires 1y;
    add_header Cache-Control "public, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  # SPA: cualquier ruta del cliente devuelve index.html.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
